# AI API 키 예시 파일.
#   1) 이 파일을 .env 로 복사한 뒤 실제 키를 채웁니다.  (.env 는 절대 커밋하지 않습니다)
#   2) 또는 OS 환경변수로 직접 설정해도 됩니다.
#
#   PowerShell :  $env:GEMINI_API_KEY = "발급받은키"
#   bash/zsh   :  export GEMINI_API_KEY="발급받은키"
#
# 키가 하나도 없으면 NewsBot 은 규칙 기반 mock 모드로 동작합니다(기능 확인은 가능).
# 어떤 키를 쓸지는 config.json 의 ai.provider 로 고르고, 'auto' 면 설정된 키를 자동 선택합니다.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
